</BaseLayout>

<style is:global>
body { background: #2a2a2a !important; }
</style>

<style>
.slides-wrap { max-width: 720px; margin: 0 auto; padding: 0 0 60px; display: flex; flex-direction: column; gap: 0; }
.slide { margin: 0; background: #000; overflow: hidden; }
.slide img { display: block; width: 100%; height: auto; margin-bottom: -1px; }
.cta-block { text-align: center; padding: 24px 12px 8px; }
.cta-block--inline { padding: 22px 12px 30px; }
.cta-lead { color: #fff; font-size: 1.05rem; line-height: 1.8; font-weight: 700; margin-bottom: 20px; }
.line-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: #06c755; color: #fff; font-weight: 900; font-size: 1.1rem; padding: 20px 40px; border-radius: 12px; text-decoration: none; letter-spacing: .04em; box-shadow: 0 8px 24px rgba(6,199,85,.4); transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease; }
.line-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(6,199,85,.55); opacity: .95; }
.line-btn:active { transform: translateY(0); opacity: .9; }
@media (max-width: 480px) {
  .slides-wrap { padding: 10px 8px 40px; gap: 10px; }
  .cta-lead { font-size: .98rem; }
  .line-btn { font-size: 1rem; padding: 18px 32px; }
}
</style>
