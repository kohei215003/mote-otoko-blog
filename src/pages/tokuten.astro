<style is:global>
body { background: #2a2a2a !important; }
</style>

<style>
.slides-wrap {
  max-width: 720px;
  margin: 0 auto;
  padding: 16px 12px 60px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.slide {
  margin: 0;
  background: #fff;
  border-radius: 4px;
  overflow: hidden;
  box-shadow: 0 6px 20px rgba(0,0,0,.35);
}
.slide img {
  display: block;
  width: 100%;
  height: auto;
}

/* タップ可能スライド */
.slide--tappable {
  position: relative;
  display: block;
  text-decoration: none;
  cursor: pointer;
  transition: transform .2s ease, box-shadow .2s ease;
}
.slide--tappable:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 32px rgba(0,0,0,.5);
}
@media (max-width: 480px) {
  .slides-wrap { padding: 10px 8px 40px; gap: 10px; }
}
</style>
