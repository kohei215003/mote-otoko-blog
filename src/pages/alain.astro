<style is:global>
body { background: #2a2a2a !important; }
</style>

<style>
.slides-wrap { max-width: 720px; margin: 0 auto; padding: 28px 0 90px; background: #000; display: flex; flex-direction: column; gap: 0; }
.slide { margin: 0; background: #000; overflow: hidden; }
.slide img { display: block; width: 100%; height: auto; margin-bottom: -1px; }
.cta-block { text-align: center; padding: 24px 12px 8px; }
.cta-block--inline { padding: 22px 12px 30px; }
.line-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: #06c755; color: #fff; font-weight: 900; font-size: 1.1rem; padding: 20px 28px; border-radius: 12px; text-decoration: none; letter-spacing: .02em; line-height: 1.4; box-shadow: 0 8px 24px rgba(6,199,85,.4); transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease; }
.line-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(6,199,85,.55); opacity: .95; }
.line-btn:active { transform: translateY(0); opacity: .9; }
.roadmap-btn { width: 100%; max-width: 620px; text-align: center; }
.btn-txt { display: flex; flex-direction: column; align-items: center; line-height: 1.4; gap: 2px; }
.btn-txt > span:first-child { font-size: .86em; opacity: .95; }
@media (max-width: 480px) {
  .line-btn { font-size: .95rem; padding: 17px 18px; }
}

/* 追従ボタン */
.sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 120; display: flex; justify-content: center; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: linear-gradient(to top, rgba(0,0,0,.92) 55%, rgba(0,0,0,0)); pointer-events: none; opacity: 0; transform: translateY(120%); transition: opacity .3s ease, transform .3s ease; }
.sticky-cta.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
.sticky-cta__btn { max-width: 620px; font-size: 1rem; padding: 15px 18px; border-radius: 14px; }
@media (max-width: 480px) { .sticky-cta__btn { font-size: .86rem; padding: 14px 14px; } }
</style>

<script>
(function () {
  var bar = document.getElementById('stickyCta');
  if (!bar) return;
  var inline = document.querySelectorAll('.cta-block--inline .roadmap-btn');
  var anyInlineVisible = false;
  var visSet = new Set();
  if ('IntersectionObserver' in window && inline.length) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) visSet.add(e.target); else visSet.delete(e.target); });
      anyInlineVisible = visSet.size > 0;
      update();
    }, { threshold: 0.4 });
    inline.forEach(function (el) { io.observe(el); });
  }
  function update() {
    var show = window.scrollY > 400 && !anyInlineVisible;
    bar.classList.toggle('is-visible', show);
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
})();
</script>
